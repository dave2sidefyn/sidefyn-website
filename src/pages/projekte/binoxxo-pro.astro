---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
const base = import.meta.env.BASE_URL;

const screenshots = [
  { image: 'start', alt: 'Binoxxo Pro: Startseite mit neuen Rätseln, Formen-Rätseln und Zeitungsrätseln', caption: 'Ein Rätsel für zwischendurch' },
  { image: 'puzzle', alt: 'Ein 10×10-Binoxxo mit X und O, Timer und Tippfunktion', caption: 'Direkt am Bildschirm lösen' },
  { image: 'newspaper', alt: 'Zeitungsrätsel fotografieren, aus der Galerie laden oder von Hand übertragen', caption: 'Das Rätsel aus der Zeitung mitnehmen' },
];
---

<ProjectLayout
  title="Binoxxo Pro – Vom vergessenen Stift zur Rätsel-App | sidefyn"
  description="Im Zug nach Frankfurt entstand Binoxxo Pro: Zeitungsrätsel fotografieren und am Handy lösen. Mit Claude komplett auf dem Smartphone entwickelt."
  eyebrow="Im Zug entstanden. Am Handy gebaut."
  heading="Binoxxo Pro"
>
  <img
    src={`${base}img/work/binoxxo-pro.webp`}
    alt="Binoxxo Pro in drei Ansichten: Startseite, Rätselgitter und Zeitungsrätsel-Import"
    width="1280"
    height="720"
    class="w-full rounded-lg border border-gray-200 mb-10"
    loading="eager"
  />

  <div class="space-y-5 text-gray-700 leading-relaxed mb-10">
    <h2 class="font-display text-2xl text-navy">Ein Rätsel, eine Zugfahrt und kein Stift</h2>
    <p>
      Ich sass im Zug nach Frankfurt, ein Binoxxo-Rätsel vor mir. Eigentlich die perfekte Beschäftigung
      für unterwegs. Nur: Ich hatte keinen Stift dabei. Also konnte ich es nicht ausfüllen.
    </p>
    <p>
      Wenige Minuten später stand die erste selbst gebaute digitale Version: das Binoxxo einscannen
      und direkt am Handy ausfüllen. Aus dem fehlenden Stift war eine Idee geworden, die ich gleich
      ausprobieren konnte.
    </p>
    <p>
      Von da an brauchte es nur noch ein paar Stunden mit Claude – komplett auf dem Smartphone –,
      bis ich die erste Version der mobilen App zur Veröffentlichung einreichen konnte.
      So wurde aus einer Lösung für meine eigene Zugfahrt Binoxxo Pro.
    </p>

    <h2 class="font-display text-2xl text-navy pt-3">Dein Binoxxo ist schon dabei</h2>
    <p>
      Mit Binoxxo Pro kannst du ein Rätsel aus der Zeitung fotografieren oder von Hand übertragen
      und auf dem Bildschirm lösen. Und wenn du gerade keine Zeitung dabei hast, erstellt die App
      neue Rätsel in verschiedenen Grössen und Schwierigkeitsstufen. Auch Formen-Rätsel sind dabei,
      dazu Tipps und die Möglichkeit, später weiterzuspielen.
    </p>
    <p>
      Wenn du also etwas freie Zeit füllen möchtest oder auf einer Reise einfach deinen Stift
      vergessen hast, ist die App vielleicht auch etwas für dich. Probier sie aus – über dein
      Feedback freue ich mich persönlich.
    </p>
  </div>

  <section aria-labelledby="binoxxo-screenshots" class="mb-10">
    <h2 id="binoxxo-screenshots" class="font-display text-2xl text-navy mb-5">Ein Blick in die App</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {screenshots.map((screenshot) => (
        <figure class="max-w-64 mx-auto w-full">
          <a href={`${base}img/work/binoxxo-pro/${screenshot.image}.webp`} class="block rounded-xl overflow-hidden border border-gray-200 hover:border-brand transition-colors">
            <img
              src={`${base}img/work/binoxxo-pro/${screenshot.image}.webp`}
              alt={screenshot.alt}
              width="390"
              height="844"
              class="w-full h-auto"
              loading="lazy"
            />
          </a>
          <figcaption class="text-sm text-gray-600 text-center mt-3">{screenshot.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-4 mb-10">
    <a href="https://binoxxo.pro/" target="_blank" rel="noopener" class="inline-block bg-brand text-navy hover:bg-brand-dark hover:text-white transition-colors px-5 py-3 text-sm font-display tracking-wide rounded-lg">
      Binoxxo Pro ausprobieren →
    </a>
    <button data-drawer="kontakt" class="text-brand font-display text-sm hover:underline">Mir persönlich Feedback geben</button>
  </div>

  <div class="border-t border-gray-100 pt-8 flex flex-wrap items-center gap-4">
    <button data-drawer="kontakt" class="inline-block border border-brand text-brand hover:bg-brand hover:text-white transition-colors px-5 py-2 text-sm font-display tracking-wide">
      Eine eigene App-Idee? Schreib mir
    </button>
    <a href={`${base}#ausgewaehlte-projekte`} class="text-gray-500 hover:text-brand text-sm font-display">← Alle Projekte ansehen</a>
  </div>
</ProjectLayout>
