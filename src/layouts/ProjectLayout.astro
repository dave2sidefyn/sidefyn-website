---
import Layout from './Layout.astro';
import Backdrop from '../components/Backdrop.astro';
import HeaderNav from '../components/HeaderNav.astro';
import Footer from '../components/Footer.astro';
import DrawerKontakt from '../components/DrawerKontakt.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
}

const { title, description, eyebrow, heading } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={title} description={description}>
  <Backdrop />
  <HeaderNav />

  <main>
    <section class="bg-navy pt-32 pb-16 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <a href={`${base}#ausgewaehlte-projekte`} class="text-brand text-sm font-display tracking-wide hover:underline">
          ← Alle Projekte
        </a>
        <p class="text-brand text-sm font-display tracking-widest uppercase mt-4 mb-2">{eyebrow}</p>
        <h1 class="font-display text-3xl md:text-5xl text-white">{heading}</h1>
      </div>
    </section>

    <article class="bg-white py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <slot />
      </div>
    </article>
  </main>

  <Footer />
  <DrawerKontakt />
  <script type="module" src={`${base}scripts/site.js`}></script>
</Layout>
