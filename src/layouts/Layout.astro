---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'sidefyn – Webseiten & Digitalisierung für Startups & KMU in Bern',
  description = 'sidefyn hilft Startups, KMU und Vereinen in Bern zu einer neuen Webseite, Webapplikation oder Digitalisierung. Schnell, unkompliziert und fair budgetiert.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = (Astro.site?.toString() ?? 'https://sidefyn.ch').replace(/\/$/, '');
const assetUrl = (path: string) => new URL(path.replace(/^\//, ''), `${siteUrl}${base}`).toString();
const pageUrl = siteUrl + Astro.url.pathname;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'sidefyn GmbH',
  url: siteUrl + base,
  logo: assetUrl('/img/logo/sidefyn.webp'),
  image: assetUrl('/img/logo/sidefyn.webp'),
  description,
  email: 'info@sidefyn.ch',
  telephone: '+41795339799',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Weingartstrasse 1',
    postalCode: '3014',
    addressLocality: 'Bern',
    addressCountry: 'CH',
  },
  areaServed: {
    '@type': 'City',
    name: 'Bern',
  },
  sameAs: ['https://www.linkedin.com/in/davidwiedmer/'],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="sidefyn GmbH" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#294053" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={assetUrl('/img/logo/sidefyn.webp')} />
    <meta property="og:locale" content="de_CH" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={assetUrl('/img/logo/sidefyn.webp')} />
    <link rel="icon" type="image/png" href="img/icon/favicon.png" />
    <link rel="canonical" href={pageUrl} />
    <link rel="preload" href="/fonts/oxygen-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/oxygen-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/img/background/background-head2.webp" as="image" />
    <link rel="preload" href="/img/logo/sidefyn.webp" as="image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  <body class="bg-white text-gray-900">
    <slot />
  </body>
</html>
