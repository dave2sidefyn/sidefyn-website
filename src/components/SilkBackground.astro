---
// Rendered silk: soft navy folds with a slow turquoise sheen ("side fyn" = seidenfein).
// Falls back to a static navy gradient without WebGL; renders one still frame for reduced motion.
---

<div class="silk-fallback absolute inset-0" aria-hidden="true"></div>
<canvas id="silk-canvas" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>

<style>
  .silk-fallback {
    background:
      radial-gradient(60% 50% at 50% 45%, rgba(59, 186, 197, 0.18), transparent 70%),
      linear-gradient(160deg, #1b2c3a 0%, #294053 50%, #142230 100%);
  }
</style>

<script>
  const canvas = document.getElementById('silk-canvas') as HTMLCanvasElement | null;
  const gl = canvas?.getContext('webgl', { antialias: false, alpha: false, premultipliedAlpha: false });

  if (canvas && gl) {
    const vert = `
      attribute vec2 p;
      void main() { gl_Position = vec4(p, 0.0, 1.0); }
    `;
    const frag = `
      precision mediump float;
      uniform vec2 res;
      uniform float t;

      float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

      // Height of the fabric: a few long, slow folds, warped so they curve like draped silk
      float fabric(vec2 p) {
        vec2 q = p;
        q.x += 0.35 * sin(q.y * 1.3 + t * 0.21);
        q.y += 0.25 * sin(q.x * 1.1 - t * 0.17);
        float h = sin(q.x * 1.6 + q.y * 2.2 + 0.6 * sin(q.x * 2.3 + t * 0.13));
        h += 0.5 * sin(q.x * -2.4 + q.y * 1.1 + t * 0.09 + 1.7);
        h += 0.25 * sin((q.x + q.y) * 3.7 - t * 0.11);
        return h;
      }

      void main() {
        vec2 uv = gl_FragCoord.xy / res;
        vec2 p = (gl_FragCoord.xy - 0.5 * res) / min(res.x, res.y) * 1.4;

        // Surface normal from the height field -> light it like a satin surface
        float e = 0.01;
        float h = fabric(p);
        vec2 grad = vec2(fabric(p + vec2(e, 0.0)) - h, fabric(p + vec2(0.0, e)) - h) / e;
        vec3 n = normalize(vec3(-grad * 0.22, 1.0));

        // Light slowly sweeps across, giving the gliding sheen
        vec3 l = normalize(vec3(0.55 * sin(t * 0.07), 0.45, 0.75));
        float diff = clamp(dot(n, l), 0.0, 1.0);
        vec3 hv = normalize(l + vec3(0.0, 0.0, 1.0));
        float spec = pow(clamp(dot(n, hv), 0.0, 1.0), 38.0);

        vec3 deep  = vec3(0.075, 0.125, 0.170);   // shadow in the folds
        vec3 navy  = vec3(0.161, 0.251, 0.325);   // #294053
        vec3 teal  = vec3(0.231, 0.729, 0.773);   // #3bbac5

        vec3 col = mix(deep, navy, smoothstep(0.35, 1.0, diff));
        col += teal * spec * 0.34;
        col += vec3(0.85, 0.95, 1.0) * pow(spec, 3.0) * 0.12;

        // Calm the centre a little so logo and text stay crisp; darken the edges
        float d = length((uv - vec2(0.5, 0.48)) * vec2(1.0, 1.25));
        col *= mix(0.80, 1.05, smoothstep(0.05, 0.45, d)) * mix(1.0, 0.72, smoothstep(0.45, 0.95, d));

        col += (hash(gl_FragCoord.xy + t) - 0.5) / 255.0 * 2.0; // dither against banding
        gl_FragColor = vec4(col, 1.0);
      }
    `;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);

    if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uRes = gl.getUniformLocation(prog, 'res');
      const uT = gl.getUniformLocation(prog, 't');

      const scale = 0.5; // soft fabric needs no full resolution; keeps it light on laptops and phones
      const resize = () => {
        canvas.width = Math.max(1, Math.round(canvas.clientWidth * scale));
        canvas.height = Math.max(1, Math.round(canvas.clientHeight * scale));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
      };
      resize();
      window.addEventListener('resize', resize);

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const start = performance.now();
      let visible = true;
      let raf = 0;
      const draw = (now: number) => {
        gl.uniform1f(uT, 20.0 + (now - start) / 1000 * 0.7);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
        if (!reduced && visible) raf = requestAnimationFrame(draw);
      };
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        cancelAnimationFrame(raf);
        if (visible) raf = requestAnimationFrame(draw);
      }).observe(canvas);
      raf = requestAnimationFrame(draw);
    } else {
      canvas.remove();
    }
  }
</script>
