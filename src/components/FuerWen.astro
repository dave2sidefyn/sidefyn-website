---
const personas = [
  {
    icon: 'M12 15c1.5 0 3-1 3-3 0-4-3-8-3-8s-3 4-3 8c0 2 1.5 3 3 3ZM9 14c-1 1-1 3-1 5 1-1 2-2 3-2M15 14c1 1 1 3 1 5-1-1-2-2-3-2M10.5 10.5a1.5 1.5 0 1 0 3 0 1.5 1.5 0 0 0-3 0Z',
    title: 'Startups & Neugründungen',
    text: 'Du brauchst eine erste Webseite oder App, die einfach steht und mitwächst, ohne grosses Agentur-Overhead und lange Anlaufzeit.',
  },
  {
    icon: 'M4 21V8l8-5 8 5v13M9 21v-6h6v6M4 21h16M9 12h.01M15 12h.01M9 8h.01M15 8h.01',
    title: 'KMU mit Digitalisierungsbedarf',
    text: 'Manuelle Prozesse kosten dich Zeit und Nerven. Ich digitalisiere und automatisiere, was sich in deinem Alltag wiederholt.',
  },
  {
    icon: 'M13 2 3 14h7l-1 8 10-12h-7l1-8Z',
    title: 'Grosse Vision, jedes Budget',
    text: 'Ob grosse Vision oder kleines Projekt: Ich denke gross, arbeite aber schnell, unkompliziert und fair budgetiert. Kein Auftrag ist zu klein, keine Idee zu gross.',
  },
];
---

<section id="fuer-wen" class="bg-navy py-20">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="reveal font-display text-2xl md:text-3xl text-white text-center mb-2">Für wen ich da bin</h2>
    <p class="reveal text-white/70 text-center mb-12 max-w-2xl mx-auto" style="transition-delay: 0.1s">
      Egal ob Startup, KMU oder Verein: Ich helfe dir unkompliziert weiter.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      {personas.map((p, i) => (
        <div class="reveal flex flex-col h-full text-center" style={`transition-delay: ${i * 0.15}s`}>
          <svg class="h-10 w-10 mx-auto mb-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d={p.icon} />
          </svg>
          <h3 class="font-display text-lg text-white mb-3">{p.title}</h3>
          <p class="text-white/70 text-sm leading-relaxed mb-6 flex-1">{p.text}</p>
          <button data-drawer="kontakt" class="mt-auto inline-block border border-white/30 text-white hover:bg-brand hover:border-brand transition-colors px-5 py-2 text-sm font-display tracking-wide self-center">
            Unverbindlich anfragen
          </button>
        </div>
      ))}
    </div>
  </div>
</section>
